{
  "description": "pr-squad: a pull request is only created once the current commit has been reviewed. Set PR_SQUAD_SKIP=1 to turn it off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/require-review.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
